rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Trips collection and subcollections
    match /trips/{tripId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
